# AI (optional — app works offline without any key):
# Groq FIRST (free, no card, ~30 req/min): https://console.groq.com → API Keys.
# One key is enough (limits are per-organization); VITE_GROQ_KEYS takes spares comma-separated.
VITE_GROQ_KEY=
# VITE_GROQ_KEYS=key1,key2
# Gemini FALLBACK (free tier): https://aistudio.google.com/app/apikey
VITE_GEMINI_KEY=
# VITE_GEMINI_MODEL=gemini-2.0-flash
# Shared leaderboard (optional — app works offline on seeds without these):
# VITE_SUPABASE_URL=https://xyzcompany.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
